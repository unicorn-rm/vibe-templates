---
import "../styles/global.css";
import T from "../components/T.astro";
import { Content as EssayEn } from "../content/essay.en.mdx";
import { Content as EssayRu } from "../content/essay.ru.mdx";

type L = { en: string; ru: string };
const POSTS: [string, L, string][] = [
  ["No. 48", { en: "On reading in places, not times", ru: "Читать в местах, а не во времени" }, "7"],
  ["No. 47", { en: "The second-hand bookshop as a library", ru: "Букинист как библиотека" }, "19"],
  ["No. 46", { en: "Why I stopped tracking pages", ru: "Почему я перестала считать страницы" }, "31"],
  ["No. 45", { en: "Reading aloud to nobody", ru: "Читать вслух никому" }, "44"],
  ["No. 44", { en: "Five books that are better on paper", ru: "Пять книг, которые лучше на бумаге" }, "52"],
];
---
<!doctype html>
<html lang="en" data-lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Marginalia — a newsletter about reading slowly</title>
  <meta name="description" content="Blog and newsletter template styled as a pocket paperback: tri-band cover, running heads, margin footnotes, a page counter instead of a progress bar. Astro + MDX." />
  <meta name="theme-color" content="#e8642a" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23e8642a'/%3E%3Crect y='11' width='32' height='10' fill='%23fbf8f0'/%3E%3C/svg%3E" />
  <link rel="alternate" type="application/rss+xml" title="Marginalia" href="https://example.com/feed.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Alegreya+Sans+SC:wght@500;800&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&display=swap" rel="stylesheet" />
  <script is:inline>
    (() => {
      let l = new URLSearchParams(location.search).get("lang");
      try { l = l || localStorage.getItem("vt-lang"); } catch {}
      document.documentElement.dataset.lang = l === "ru" ? "ru" : "en";
      document.documentElement.lang = document.documentElement.dataset.lang;
    })();
  </script>
</head>
<body>
  <!-- the cover -->
  <header class="cover" id="top">
    <div class="cover__band"><span class="mark" aria-hidden="true">M</span><span class="series"><T t={{ en: "Marginalia · Pocket Series", ru: "Marginalia · Карманная серия" }} /></span><button id="lang" class="lang" type="button" aria-label="Switch language"><span data-l="en">RU</span><span data-l="ru">EN</span></button></div>
    <div class="cover__white">
      <p class="cover__author"><T t={{ en: "A weekly newsletter by Ilse Varga", ru: "Еженедельная рассылка Ильзе Варги" }} /></p>
      <h1>Marginalia</h1>
      <p class="cover__sub"><T t={{ en: "Notes on reading slowly", ru: "Заметки о медленном чтении" }} /></p>
    </div>
    <div class="cover__band cover__band--low"><span>No. 48</span><span><T t={{ en: "Sunday, 22 November 2026", ru: "Воскресенье, 22 ноября 2026" }} /></span><span>4 200 <T t={{ en: "readers", ru: "читателей" }} /></span></div>
  </header>

  <!-- running head, sticks while reading -->
  <div class="running" aria-hidden="true">
    <span>Marginalia</span>
    <span class="running__title"><T t={POSTS[0][1]} /></span>
    <span id="pageNo">p. 7</span>
  </div>

  <main class="book">
    <section class="contents" aria-labelledby="contentsTitle">
      <h2 id="contentsTitle"><T t={{ en: "Contents", ru: "Содержание" }} /></h2>
      <ol>
        {POSTS.map(([no, title, page], i) => (
          <li class={i === 0 ? "is-current" : ""}>
            <a href={i === 0 ? "#essay" : "#"}><span class="no">{no}</span><span class="t"><T t={title} /></span><span class="dots" aria-hidden="true"></span><span class="pg">{page}</span></a>
          </li>
        ))}
      </ol>
    </section>

    <article id="essay" class="essay">
      <p class="essay__no">No. 48</p>
      <h2 class="essay__title"><T t={POSTS[0][1]} /></h2>
      <p class="essay__meta"><T t={{ en: "6 minutes · 3 notes in the margin", ru: "6 минут · 3 пометки на полях" }} /></p>
      <div class="prose" data-l="en"><EssayEn /></div>
      <div class="prose" data-l="ru" lang="ru"><EssayRu /></div>
      <p class="dinkus" aria-hidden="true">❦</p>
    </article>

    <section class="colophon">
      <h2><T t={{ en: "Get it on Sundays", ru: "Получать по воскресеньям" }} /></h2>
      <p><T t={{ en: "One essay, three books, one reader's note. No tracking pixels, no 'growth hacks', unsubscribe in one click.", ru: "Одно эссе, три книги, одна пометка читателя. Без пикселей слежения и «гроус-хаков», отписка в один клик." }} /></p>
      <p class="subs"><a href="mailto:hello@example.com?subject=Subscribe"><T t={{ en: "Subscribe by email", ru: "Подписаться по почте" }} /></a> · <a href="https://example.com/feed.xml">RSS</a></p>
    </section>
  </main>

  <footer class="foot"><span>© 2026 Marginalia</span><span><T t={{ en: "Template by vibe-templates · fictional newsletter · MIT", ru: "Шаблон vibe-templates · вымышленная рассылка · MIT" }} /></span></footer>

  <script>
    const root = document.documentElement;
    document.getElementById("lang")!.addEventListener("click", () => {
      const l = root.dataset.lang === "en" ? "ru" : "en";
      root.dataset.lang = l; root.lang = l;
      try { localStorage.setItem("vt-lang", l); } catch {}
      page();
    });

    /* page counter: the essay is "pages 7–18" of the issue; scroll maps onto them */
    const FIRST = 7, LAST = 18;
    const out = document.getElementById("pageNo")!;
    function page() {
      const essay = document.querySelector<HTMLElement>(".essay")!;
      const r = essay.getBoundingClientRect();
      const k = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight)));
      const p = Math.round(FIRST + k * (LAST - FIRST));
      out.textContent = root.dataset.lang === "ru" ? `с. ${p} из ${LAST}` : `p. ${p} of ${LAST}`;
    }
    addEventListener("scroll", page, { passive: true }); page();
  </script>
</body>
</html>
