---
import "../styles/global.css";
import T from "../components/T.astro";
import { Content as GuideEn } from "../content/guide.en.mdx";
import { Content as GuideRu } from "../content/guide.ru.mdx";

// thumb-index tabs: id → label. Russian headings use the same id + "-ru".
const CHAPTERS = [
  ["intro", { en: "Intro", ru: "Введение" }],
  ["install", { en: "Install", ru: "Установка" }],
  ["start", { en: "Start", ru: "Старт" }],
  ["retries", { en: "Retries", ru: "Повторы" }],
  ["api", { en: "API", ru: "API" }],
  ["changelog", { en: "Changes", ru: "Изменения" }],
] as const;
---
<!doctype html>
<html lang="en" data-lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Ferry Reference Manual — a 2 kB HTTP client</title>
  <meta name="description" content="Open-source library docs template styled as a 1980s printed reference manual: thumb-index tabs, MDX chapters, ⌘K search, copyable install tabs. Astro + MDX." />
  <meta name="theme-color" content="#f7f6f1" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23f7f6f1'/%3E%3Crect x='4' y='4' width='18' height='24' fill='none' stroke='%23111' stroke-width='2'/%3E%3Crect x='22' y='6' width='6' height='5' fill='%23005f73'/%3E%3Crect x='22' y='13' width='6' height='5' fill='%23111'/%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geologica:wght@300;400;600;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <script is:inline>
    (() => {
      let l = new URLSearchParams(location.search).get("lang");
      try { l = l || localStorage.getItem("vt-lang"); } catch {}
      document.documentElement.dataset.lang = l === "ru" ? "ru" : "en";
      document.documentElement.lang = document.documentElement.dataset.lang;
    })();
  </script>
</head>
<body>
  <header class="bar">
    <a href="#top" class="bar__title"><b>FERRY</b> <span><T t={{ en: "Reference Manual", ru: "Справочное руководство" }} /></span></a>
    <span class="bar__ver">Version 3.2 · Part No. FR-0032</span>
    <button class="bar__search" id="openSearch" type="button"><T t={{ en: "Search", ru: "Поиск" }} /> <kbd>⌘K</kbd></button>
    <button class="bar__lang" id="lang" type="button" aria-label="Switch language"><span data-l="en">RU</span><span data-l="ru">EN</span></button>
  </header>

  <!-- thumb index: stepped tabs on the page edge -->
  <nav class="thumbs" aria-label="Chapters">
    {CHAPTERS.map(([id, label], i) => (
      <a class="thumb" style={`--i:${i}`} href={`#${id}`} data-id={id}><span class="thumb__n">{i + 1}</span><span class="thumb__l"><T t={label} /></span></a>
    ))}
  </nav>

  <main id="top" class="manual">
    <section class="cover">
      <p class="cover__part">Part No. FR-0032 · <T t={{ en: "First edition, November 2026", ru: "Первое издание, ноябрь 2026" }} /></p>
      <h1>Ferry<br /><span><T t={{ en: "HTTP client", ru: "HTTP-клиент" }} /></span></h1>
      <p class="cover__lead"><T t={{ en: "2 kB. Timeouts, retries with backoff, typed JSON, cancellation. Nothing else.", ru: "2 кБ. Тайм-ауты, повторы с паузами, типизированный JSON, отмена. Больше ничего." }} /></p>
      <dl class="cover__specs">
        <div><dt><T t={{ en: "Size", ru: "Размер" }} /></dt><dd>2.1 kB gz</dd></div>
        <div><dt><T t={{ en: "Dependencies", ru: "Зависимости" }} /></dt><dd>0</dd></div>
        <div><dt><T t={{ en: "Runtimes", ru: "Среды" }} /></dt><dd>Browser · Node 18+ · Deno · Bun</dd></div>
        <div><dt><T t={{ en: "License", ru: "Лицензия" }} /></dt><dd>MIT</dd></div>
      </dl>
    </section>

    <article class="doc" data-l="en"><GuideEn /></article>
    <article class="doc" data-l="ru" lang="ru"><GuideRu /></article>
  </main>

  <footer class="foot">
    <span>Ferry · <T t={{ en: "printed on the web", ru: "отпечатано в вебе" }} /></span>
    <span><T t={{ en: "Template by vibe-templates · fictional library · MIT", ru: "Шаблон vibe-templates · вымышленная библиотека · MIT" }} /></span>
  </footer>

  <dialog class="search" id="search" aria-label="Search">
    <form method="dialog" class="search__form">
      <input id="q" type="search" autocomplete="off" placeholder="Search the manual…" aria-label="Search the manual" />
      <ul id="results" class="search__results"></ul>
      <p class="search__hint">↑ ↓ · Enter · Esc</p>
    </form>
  </dialog>

  <script>
    const root = document.documentElement;
    const lang = () => root.dataset.lang as "en" | "ru";
    const suffix = () => (lang() === "ru" ? "-ru" : "");

    document.getElementById("lang")!.addEventListener("click", () => {
      const l = lang() === "en" ? "ru" : "en";
      root.dataset.lang = l; root.lang = l;
      try { localStorage.setItem("vt-lang", l); } catch {}
      spy();
    });

    /* thumb tabs jump to the chapter in the current language */
    const thumbs = [...document.querySelectorAll<HTMLAnchorElement>(".thumb")];
    thumbs.forEach((a) => a.addEventListener("click", (e) => {
      e.preventDefault();
      document.getElementById(a.dataset.id! + suffix())?.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
    }));
    /* highlight the chapter you are reading */
    function spy() {
      let on = thumbs[0];
      for (const a of thumbs) {
        const h = document.getElementById(a.dataset.id! + suffix());
        if (h && h.getBoundingClientRect().top < innerHeight * 0.35) on = a;
      }
      thumbs.forEach((a) => a.classList.toggle("is-on", a === on));
    }
    addEventListener("scroll", spy, { passive: true }); spy();

    /* install tabs + copy buttons on every code block */
    document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((box) => {
      const btns = box.querySelectorAll<HTMLButtonElement>("[data-tab]");
      btns.forEach((b) => b.addEventListener("click", () => {
        btns.forEach((x) => x.setAttribute("aria-selected", String(x === b)));
        box.querySelectorAll<HTMLElement>("[data-panel]").forEach((p) => (p.hidden = p.dataset.panel !== b.dataset.tab));
      }));
    });
    document.querySelectorAll<HTMLPreElement>(".doc pre").forEach((pre) => {
      const btn = Object.assign(document.createElement("button"), { type: "button", className: "copy", textContent: "copy" });
      btn.addEventListener("click", async () => {
        try { await navigator.clipboard.writeText(pre.innerText.trim()); btn.textContent = "✓"; } catch { btn.textContent = "×"; }
        setTimeout(() => (btn.textContent = "copy"), 1200);
      });
      pre.append(btn);
    });

    /* ⌘K search over headings and paragraphs of the visible language */
    const dlg = document.getElementById("search") as HTMLDialogElement;
    const q = document.getElementById("q") as HTMLInputElement, list = document.getElementById("results")!;
    let hits: { el: HTMLElement; text: string; head: string }[] = [], sel = 0;
    const index = () => {
      const doc = document.querySelector<HTMLElement>(`.doc[data-l="${lang()}"]`)!;
      let head = "";
      return [...doc.querySelectorAll<HTMLElement>("h2, p, li, td")].map((el) => {
        if (el.tagName === "H2") head = el.textContent!;
        return { el, text: el.textContent!.trim(), head };
      });
    };
    const render = () => {
      const s = q.value.trim().toLowerCase();
      const all = index();
      hits = (s ? all.filter((x) => x.text.toLowerCase().includes(s)) : all.filter((x) => x.el.tagName === "H2")).slice(0, 8);
      sel = 0;
      list.innerHTML = "";
      hits.forEach((h, i) => {
        const li = document.createElement("li");
        li.className = i === sel ? "is-sel" : "";
        const small = document.createElement("small"); small.textContent = h.head;
        const span = document.createElement("span"); span.textContent = h.text.slice(0, 90);
        li.append(small, span);
        li.addEventListener("click", () => go(i));
        list.append(li);
      });
    };
    const go = (i: number) => { const h = hits[i]; if (!h) return; dlg.close(); h.el.scrollIntoView({ block: "center" }); h.el.classList.add("flash"); setTimeout(() => h.el.classList.remove("flash"), 1400); };
    const open = () => { q.value = ""; render(); dlg.showModal(); q.focus(); };
    document.getElementById("openSearch")!.addEventListener("click", open);
    addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") { e.preventDefault(); open(); }
      if (!dlg.open) return;
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault(); sel = (sel + (e.key === "ArrowDown" ? 1 : -1) + hits.length) % Math.max(1, hits.length);
        [...list.children].forEach((li, i) => li.classList.toggle("is-sel", i === sel));
      }
      if (e.key === "Enter") { e.preventDefault(); go(sel); }
    });
    q.addEventListener("input", render);
    dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
  </script>
</body>
</html>
